{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LeafFreak",
  "version": "0.1.0",
  "identifier": "com.grieger.leaffreak",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "LeafFreak",
        "width": 390,
        "height": 844,
        "minWidth": 320,
        "minHeight": 568,

        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: asset: http://asset.localhost https://*.maptiler.com; connect-src 'self' ipc: http://ipc.localhost https://*.maptiler.com https://api.maptiler.com; worker-src blob:; child-src blob:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$PICTURE/**", "$DOWNLOAD/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "typegen": {
      "projectPath": ".",
      "outputPath": "../src/generated",
      "validationLibrary": "none"
    }
  }
}
